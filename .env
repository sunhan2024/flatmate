# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git.

DJANGO_SECRET_KEY=x!(-s^xflkv86nw=b4ap(1veorz!6y2t$f4n%^#p-qrxqic$*c
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — create an app at https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudflare Turnstile (bot protection) — get free keys at
# https://dash.cloudflare.com/?to=/:account/turnstile
# The defaults below are Cloudflare's public TEST keys: they always pass,
# so signup works out of the box in development. Replace before going live.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
